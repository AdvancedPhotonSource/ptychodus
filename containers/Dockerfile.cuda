ARG CUDA_VERSION=13.0
ARG PYTORCH_VERSION=2.12.0
ARG CUDNN_VERSION=9
FROM pytorch/pytorch:${PYTORCH_VERSION}-cuda${CUDA_VERSION}-cudnn${CUDNN_VERSION}-devel

ARG PTYCHODUS_VERSION
ENV SETUPTOOLS_SCM_PRETEND_VERSION_FOR_PTYCHODUS=${PTYCHODUS_VERSION} \
    VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH

WORKDIR /app
COPY . /src

# The base image's python3 is the distro-managed system Python, which carries
# the PEP 668 EXTERNALLY-MANAGED marker and refuses a plain `pip install`, so
# ptychodus goes into a venv. Three details are load-bearing:
#
#   * python3-venv supplies the ensurepip that this base image omits; without
#     it `python3 -m venv` fails outright.
#   * --system-site-packages keeps the base image's CUDA-matched torch (in
#     /usr/local/lib/python3.12/dist-packages) visible. A sealed venv would
#     make pip pull a second, generic torch from PyPI. The venv's own
#     site-packages still precedes dist-packages on sys.path, so ptychodus's
#     dependencies shadow the base image's copies as usual.
#   * The venv is addressed by absolute path below. PATH puts /opt/venv/bin
#     first, but the shell has already resolved and hashed /usr/bin/python3
#     for the `python3 -m venv` call, so a bare `python3` later in this same
#     RUN would still reach the system interpreter and trip PEP 668 again.
#
# PtychoFM (distribution `ptycho-fm`, import package `ptycho_fm`) is published
# on no index, so it cannot be named as an extra the way ptychi is. Instead
# scripts/podman/build stages a prebuilt wheel into containers/wheels/, which
# the `COPY . /src` above delivers to /src/containers/wheels/ and the trailing
# `rm -rf /src` removes again. Three more details:
#
#   * The glob is optional on purpose. A non-matching glob expands to the
#     literal pattern, which `[ -e ]` then rejects, so a plain `podman build
#     -f containers/Dockerfile.cuda .` with nothing staged still produces a
#     working image -- just without the PtychoFM backend.
#   * The wheel and /src[...] go into a SINGLE pip invocation so one resolution
#     pass reconciles ptychi's and ptycho-fm's constraints together. Installing
#     them in sequence lets the second call quietly downgrade what the first
#     pinned; ptycho-fm floors numpy, h5py and scipy well above ptychodus.
#   * ptycho-fm asks for torch>=2.6.0, which the base image's CUDA build
#     already satisfies through --system-site-packages, so this pulls no torch
#     from PyPI. A `torch.__version__` without a +cuXXX suffix in the built
#     image means that went wrong.
RUN apt-get update && \
    apt-get install -y --no-install-recommends libqt5gui5 python3-venv && \
    rm -rf /var/lib/apt/lists/* && \
    python3 -m venv --system-site-packages "${VIRTUAL_ENV}" && \
    "${VIRTUAL_ENV}/bin/python" -m pip install --no-cache-dir --upgrade pip && \
    set -- '/src[globus,gui,ptychi]' && \
    for whl in /src/containers/wheels/*.whl; do \
        if [ -e "$whl" ]; then set -- "$@" "$whl"; fi; \
    done && \
    "${VIRTUAL_ENV}/bin/python" -m pip install --no-cache-dir "$@" && \
    rm -rf /src

CMD ["python3", "-m", "ptychodus"]
