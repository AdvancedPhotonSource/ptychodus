ARG BASE_REGISTRY=docker.io
ARG BASE_TAG=2.8.10-xpu
FROM ${BASE_REGISTRY}/intel/intel-extension-for-pytorch:${BASE_TAG}

ARG PTYCHODUS_VERSION

# The base image ships torch 2.8.0+xpu alongside intel_extension_for_pytorch
# (the IPEX / XPU stack for ALCF Aurora) on Python 3.11; pip sees the torch
# requirement satisfied and leaves it alone. Intel's own build of this image
# deletes /usr/lib/python3.11/EXTERNALLY-MANAGED, so installing into the
# system tree is the sanctioned path here and no venv is needed.
#
# This is a headless image for batch and HPC use, with pty-chi as its only
# backend; the GUI needs the CPU or CUDA image. ptychodus comes from PyPI: the
# release named by PTYCHODUS_VERSION, or the latest one when it is unset. An
# unpinned build reuses its cached layer after a new release, so pin it or
# pass --no-cache. /tmp/constraints.txt pins the base image's torch, and
# torchvision when it ships one, so no dependency can make pip swap the
# XPU build for PyPI's generic torch; pip backtracks or fails instead.
RUN python3 -m pip install --root-user-action=ignore --no-cache-dir --upgrade pip && \
    python3 -c 'import importlib.metadata as m; [print(f"{d}=={m.version(d)}") for d in ("torch", "torchvision") if d in {x.metadata["Name"] for x in m.distributions()}]' \
        > /tmp/constraints.txt && \
    python3 -m pip install --root-user-action=ignore --no-cache-dir -c /tmp/constraints.txt \
        "ptychodus[ptychi]${PTYCHODUS_VERSION:+==$PTYCHODUS_VERSION}" && \
    rm /tmp/constraints.txt

CMD ["python3", "-m", "ptychodus"]
